# .env.example

# --- Database Configuration ---
# Recommended: A strong, random password.
POSTGRES_HOST=jdbc:postgresql://localhost:5432
POSTGRES_DB=tsi_dpdp_cms
POSTGRES_USER=postgres
POSTGRES_PASSWD=<<password>>

# --- Application Configuration ---
# JWT_SECRET: minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=<<generate-with-openssl-rand-hex-32>>
# DB_ENCRYPTION_KEY: used by pgcrypto to encrypt PII columns (email, phone).
# Must match the value set in PostgreSQL via: ALTER DATABASE ... SET app.enc_key = '...';
# Generate with: openssl rand -hex 32  — never change after first use (data loss)
DB_ENCRYPTION_KEY=<<generate-with-openssl-rand-hex-32>>
# TSI_LOOKUP_SALT: HMAC salt for pseudonymising user IDs in audit logs.
# Generate with: openssl rand -hex 32
TSI_LOOKUP_SALT=<<generate-with-openssl-rand-hex-32>>
# TSI_BOOTSTRAP_TOKEN: required to complete the one-time Super-Admin setup at
# /console/setup/init.html (POST /api/v1/bootstrap/setup). No default — if
# unset, that endpoint refuses every request (503) rather than allowing
# unauthenticated account creation. Generate with: openssl rand -hex 32
# Set it, complete setup, then you may unset/rotate it — it isn't needed again
# unless the operators table is ever emptied (e.g. a DB restore).
TSI_BOOTSTRAP_TOKEN=<<generate-with-openssl-rand-hex-32>>
# ALLOWED_ORIGINS: comma-separated list of permitted origins for CORS
ALLOWED_ORIGINS=https://your-domain.com
# ACCESS_SLA_DAYS / CORRECTION_SLA_DAYS: days allowed to fulfil an access (s.11) / correction (s.12) request. Leave
# UNSET until your counsel has confirmed the timelines under the Rules: with no value a request has no deadline and
# is never shown as overdue. Whole numbers from 1 to 365.
# ACCESS_SLA_DAYS=
# CORRECTION_SLA_DAYS=
# CONSENT_CAPTURE_MODE: warn (default) accepts consent that breaks the capture rules (a purpose left unanswered, a
# minor without a verified guardian log) and records a CONSENT_CAPTURE_WARNING audit event; strict rejects it.
# CONSENT_CAPTURE_MODE=warn
# TRUSTED_PROXY: comma-separated addresses of your reverse proxies (e.g. nginx). X-Forwarded-For is believed only
# when the request comes from one of them, so the recorded client address is the real one, not the proxy's.
# TRUSTED_PROXY=
# ACCESS_CONTROL_MODE: shadow (default) logs what the role/permission and tenant checks WOULD refuse
# without blocking anything; enforce applies them. See docs/security/access-control-rollout.md
# ACCESS_CONTROL_MODE=shadow
# MFA (TOTP): operators can enrol in every mode. In production it is mandatory for ADMIN and DPO
# and cannot be switched off. For other modes, MFA_ENFORCE=true applies the production rule (for testing).
# MFA_ENFORCE=false
# TOKEN_TTL_MINUTES: operator session lifetime (default 480 = 8 hours)
# TOKEN_TTL_MINUTES=480
TSI_DPDP_CMS_ENV=production
TSI_DPDP_CMS_HOME=/home/tsicoop/tsi-dpdp-cms
TSI_EXPORT_PATH=/var/lib/tsi/exports/
TSI_KEYSTORE_PATH=/var/lib/tsi/consentmgr.p12
TSI_KEYSTORE_PASS=<<keystore-password>>
TSI_KEYSTORE_ALIAS=abc-consentmgr

# --- White-labeling (optional) ---
# BRAND_NAME: partner/reseller brand shown throughout the UI instead of the
# default "TSI DPDP CMS". Max 12 characters — the app refuses to start if this
# is exceeded (the limit matches the default brand's length, so any compliant
# value is guaranteed to fit existing layouts without redesign).
BRAND_NAME=ACME PRIVACY
