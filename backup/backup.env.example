# Copy to backup.env (gitignored) and edit. Plain environment variables work too.

DB_CONTAINER=tsi_dpdp_cms_db
POSTGRES_DB=tsi_cms
POSTGRES_USER=tsi_admin

# Local staging directory for the backup files.
LOCAL_BACKUP_DIR=$HOME/tsi-dpdp-cms-backups

# Where backups are copied to (a NAS mount, external drive, ...). Must already exist.
# If unset, backups stay in LOCAL_BACKUP_DIR only and the script warns.
#BACKUP_DEST_DIR=/mnt/nas/tsi-dpdp-cms

# Days of backups to keep, in both directories.
RETENTION_DAYS=14

# Generated reports / evidence exports volume (name = <compose project>_tsi_reports_data).
INCLUDE_EXPORTS=true
EXPORTS_VOLUME=tsi-dpdp-cms_tsi_reports_data

# Secrets bundle (.env + signing keystore), encrypted with AES-256. Off by default.
# Needs a passphrase that is NOT stored with the backups - keep it in your password manager.
INCLUDE_SECRETS=false
#BACKUP_PASSPHRASE_FILE=/root/.tsi-backup-passphrase   # or export BACKUP_PASSPHRASE
ENV_FILE=../.env
#KEYSTORE_FILE=/etc/tsi/keystore.p12   # host path of the file mounted at TSI_KEYSTORE_PATH
